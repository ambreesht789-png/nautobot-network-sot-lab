# Copy this file to .env and replace every placeholder value.
# Never commit the resulting .env file.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=nautobot
POSTGRES_USER=nautobot
POSTGRES_PASSWORD=change-me-before-first-run

# --- Nautobot ---------------------------------------------------------------
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=change-me-before-first-run
NAUTOBOT_DB_HOST=postgres
NAUTOBOT_DB_PORT=5432

NAUTOBOT_REDIS_HOST=redis
NAUTOBOT_REDIS_PORT=6379

# Generate with: nautobot-server generate_secret_key
NAUTOBOT_SECRET_KEY=change-me-before-first-run
NAUTOBOT_ALLOWED_HOSTS=*
NAUTOBOT_DEBUG=False

NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
NAUTOBOT_SUPERUSER_PASSWORD=change-me-before-first-run
NAUTOBOT_CREATE_SUPERUSER=true
